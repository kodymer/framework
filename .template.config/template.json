{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/template.json",
  "identity": "Enterprise.ModularFramework.Root",
  "author": "Capgemini Engineering",
  "description": "Creates the base structure for a modular and scalable enterprise framework.",
  "classifications": [
    "Code"
  ],
  "shortName": "fwk",
  "name": "Enterprise Modular Framework",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "constraints": {
    "OS": {
      "type": "os",
      "args": [
        "Windows",
        "linux",
        "OSX"
      ]
    },
    "SDK": {
      "type": "sdk-version",
      "args": [
        "8.0.*",
        "9.0.*",
        "10.0.*"
      ]
    }
  },
  "sourceName": "CompanyName",
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        "**/.git/**",
        ".template.config/**"
      ]
    }
  ],
  "symbols": {
    "source-link": {
      "type": "parameter",
      "description": "Source control provider used for SourceLink configuration.",
      "datatype": "choice",
      "isEnabled": true,
      "isRequired": false,
      "enableQuotelessLiterals": true,
      "allowMultipleValues": false,
      "choices": [
        {
          "choice": "Microsoft.SourceLink.GitHub",
          "description": "GitHub"
        },
        {
          "choice": "Microsoft.SourceLink.AzureRepos.Git",
          "description": "Azure Repos"
        },
        {
          "choice": "Microsoft.SourceLink.Bitbucket.Git",
          "description": "Bitbucket"
        }
      ],
      "replaces": "SourceLinkPackage",
      "defaultValue": "Microsoft.SourceLink.GitHub"
    },
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Target framework",
      "choices": [
        {
          "choice": "net8.0",
          "description": "Target .NET 8 (LTS)"
        },
        {
          "choice": "net9.0",
          "description": "Target .NET 9 (STS)"
        },
        {
          "choice": "net10.0",
          "description": "Target .NET 10 (LTS)"
        }
      ],
      "defaultValue": "net8.0",
      "replaces": "TargetFrameworkOverride"
    },
    "nuget": {
      "type": "parameter",
      "description": "Optional custom NuGet feed URL (leave empty to skip).",
      "datatype": "string",
      "replaces": "NugetSource",
      "defaultValue": "",
      "displayName": "NuGet Source URL"
    },
    "dotnetSdk": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(framework == 'net8.0')",
            "value": "8.0.100"
          },
                    {
            "condition": "(framework == 'net9.0')",
            "value": "9.0.100"
          },
                    {
            "condition": "(framework == 'net10.0')",
            "value": "10.0.100"
          }
        ]
      },
      "replaces": "NetSDK"
    },
    "sourceLinkVersion": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(framework == 'net8.0')",
            "value": "10.0.300"
          },
                    {
            "condition": "(framework == 'net9.0')",
            "value": "10.0.300"
          },
                    {
            "condition": "(framework == 'net10.0')",
            "value": "10.0.300"
          }
        ]
      },
      "replaces": "SourceLinkVersion"
    },
    "hasNugetCorp": {
      "type": "computed",
      "value": "nuget != ''"
    },
    "lowerName": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "CompanyNameLower",
      "fileRename": "CompanyNameLower"
    },
    "templateOn": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "template"
      },
      "fileRename": "__template"
    },
    "workingDirectory": {
      "type": "bind",
      "binding": "host:WorkingDirectory"
    },
    "operationSystem": {
      "type": "bind",
      "binding": "env:OS"
    },
    "separator": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(operationSystem == 'Windows_NT')",
            "value": "\\"
          },
          {
            "condition": "(operationSystem != 'Windows_NT')",
            "value": "/"
          }
        ]
      }
    },
    "localNuGet": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "const",
            "value": "."
          },
          {
            "type": "ref",
            "value": "separator"
          },
          {
            "type": "const",
            "value": "nupkg"
          }
        ],
        "separator": "",
        "removeEmptyValues": false
      },
      "replaces": "NugetSourceLocal"
    }
  }
}