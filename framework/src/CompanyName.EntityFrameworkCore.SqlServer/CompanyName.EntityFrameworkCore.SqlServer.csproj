<Project Sdk="Microsoft.NET.Sdk">
  
  <Import Project="..\..\..\packages.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>CompanyName.EntityFrameworkCore.SqlServer</AssemblyName>
    <PackageId>CompanyName.EntityFrameworkCore.SqlServer</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <RootNamespace />
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CompanyName\EntityFrameworkCore\SqlServer\**" />
    <EmbeddedResource Remove="CompanyName\EntityFrameworkCore\SqlServer\**" />
    <None Remove="CompanyName\EntityFrameworkCore\SqlServer\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompanyName.EntityFrameworkCore\CompanyName.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
