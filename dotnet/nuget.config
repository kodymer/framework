<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="CompanyNameLower.nuget.dev" value="NugetSourceLocal" />
<!--#if hasNugetCorp
    <add key="CompanyNameLower.nuget.corp" value="NugetSource" />
#endif-->
  </packageSources>
</configuration>
