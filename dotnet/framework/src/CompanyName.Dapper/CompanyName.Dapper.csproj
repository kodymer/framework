<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\packages.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>CompanyName.Dapper</AssemblyName>
    <PackageId>CompanyName.Dapper</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <RootNamespace />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.SqlBuilder" />
    <PackageReference Include="Dapper.Rainbow" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompanyName.Data\CompanyName.Data.csproj" />
    <ProjectReference Include="..\CompanyName.Ddd.Domain\CompanyName.Ddd.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CompanyName.Dapper.SqlServer" />
    <InternalsVisibleTo Include="CompanyName.Dapper.Tests" />
  </ItemGroup>

</Project>
