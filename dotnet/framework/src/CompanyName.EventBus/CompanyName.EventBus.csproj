<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\..\packages.props" />

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<AssemblyName>CompanyName.EventBus</AssemblyName>
		<PackageId>CompanyName.EventBus</PackageId>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<RootNamespace />
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CompanyName.Ddd.Domain.EventBus\CompanyName.Ddd.Domain.EventBus.csproj" />
		<ProjectReference Include="..\CompanyName.EventBus.Abstractions\CompanyName.EventBus.Abstractions.csproj" />
		<ProjectReference Include="..\CompanyName.Autofac\CompanyName.Autofac.csproj" />
		<ProjectReference Include="..\CompanyName.Messaging.InProcess\CompanyName.Messaging.InProcess.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CompanyName.EventBus.AzureServiceBus" />
	</ItemGroup>

</Project>
