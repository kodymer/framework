<Project Sdk="Microsoft.NET.Sdk">


  <Import Project="..\..\..\packages.props" />
  
  <PropertyGroup>   
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>CompanyName.EventBus.AzureServiceBus</AssemblyName>
    <PackageId>CompanyName.EventBus.AzureServiceBus</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <RootNamespace />  
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompanyName.EventBus\CompanyName.EventBus.csproj" />
    <ProjectReference Include="..\CompanyName.Security\CompanyName.Security.csproj" />
    <ProjectReference Include="..\CompanyName.Messaging.AzureServiceBus\CompanyName.Messaging.AzureServiceBus.csproj" />
  </ItemGroup>

</Project>
