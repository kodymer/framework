<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\..\packages.props" />

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<AssemblyName>CompanyName.Ddd.Domain</AssemblyName>
		<PackageId>CompanyName.Ddd.Domain</PackageId>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<RootNamespace />
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CompanyName.Ddd.Domain.Abstractions\CompanyName.Ddd.Domain.Abstractions.csproj" />
		<ProjectReference Include="..\CompanyName.Localization\CompanyName.Localization.csproj" />
		<ProjectReference Include="..\CompanyName.Security\CompanyName.Security.csproj" />
	</ItemGroup>
	
</Project>
